# Force LF line endings for shell scripts
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
Dockerfile text eol=lf

# Never run line-ending conversion over binaries — it corrupts them. Git was
# reporting "LF will be replaced by CRLF" for docs/WORKFLOW.pdf without this.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.bmp   binary
*.ico   binary
*.onnx  binary
*.pth   binary
