# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Processing
USE_GPU=false
MAX_IMAGE_SIZE=1024

# ── Supabase (target-image storage) ──────────────────────────────────────────
# Project Settings → API.  Use the SERVICE ROLE key on the backend (it bypasses
# RLS for writes). Leave blank to use the local Location/ folder instead.
# Run supabase_schema.sql once in the Supabase SQL editor first.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=location-images

# ── Control Panel owner passwords (must match frontend src/pages/AdminPage.jsx)
ADMIN_PASSWORD_1=deepface@admin1
ADMIN_PASSWORD_2=deepface@admin2
